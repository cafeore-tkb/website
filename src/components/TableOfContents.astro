---
import type { TocItem } from "../utils/toc";

export interface Props {
  items: TocItem[];
}

const { items } = Astro.props;
---

<nav class="toc" aria-labelledby="toc-title">
  <p class="toc-title" id="toc-title">目次</p>
  <ol class="toc-list">
    {
      items.map((item) => (
        <li class="toc-item" data-level={item.level}>
          <a class="toc-link" href={`#${encodeURIComponent(item.id)}`}>
            {item.text}
          </a>
        </li>
      ))
    }
  </ol>
</nav>

<style>
  .toc {
    padding: 1rem 1.25rem;
    margin-block-end: 2rem;
    margin-inline: 1rem;
    background-color: rgb(from var(--cafeore-cream) r g b / 12%);
    border-radius: 8px;
  }

  .toc-title {
    margin-block: 0 0.75rem;
    font-size: 0.95rem;
    font-weight: bold;
    color: var(--cafeore-brown);
    letter-spacing: 0.08em;
  }

  .toc-list {
    padding: 0;
    margin: 0;
    list-style: none;
    counter-reset: toc-item;
  }

  .toc-item {
    position: relative;
    padding-inline-start: 1.8em;
    margin-block: 0.35em;
    line-height: 1.6;
    counter-increment: toc-item;
  }

  .toc-item::before {
    position: absolute;
    inset-inline-start: 0;
    width: 1.3em;
    font-size: 0.85em;
    font-weight: bold;
    font-variant-numeric: tabular-nums;
    color: var(--sepia);
    text-align: end;
    content: counter(toc-item) ".";
  }

  /* h3 は一段下げて階層が分かるようにする */
  .toc-item[data-level="3"] {
    padding-inline-start: 3.2em;
    font-size: 0.92em;
  }

  .toc-item[data-level="3"]::before {
    inset-inline-start: 1.4em;
  }

  .toc-link {
    color: var(--dark-gray);
    text-decoration: none;
    text-underline-offset: 0.2em;
  }

  .toc-link:hover {
    color: var(--orange);
    text-decoration: underline;
  }

  @media (width <= 620px) {
    .toc {
      margin-inline: 1rem;
    }
  }
</style>
