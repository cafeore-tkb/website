---
import { CAFEORE_NAME } from "../consts";
import {
  organizationNode,
  serializeJsonLd,
  webSiteNode,
  type JsonLdNode,
} from "../utils/jsonld";
import "../global.css";
export interface Props {
  title?: string;
  ogImageUrl?: string | undefined;
  noIndex?: boolean;
  /** ページ固有の構造化データ。団体とサイトのノードは常に自動で入る */
  jsonLd?: JsonLdNode[];
}

const {
  title: pageTitle,
  ogImageUrl,
  noIndex = false,
  jsonLd = [],
} = Astro.props;

const isHome = Astro.url.pathname === "/";
// トップページならサイトタイトルだけ、そうでなければ「ページタイトル | サイトタイトル」とする
const fullTitle = isHome ? CAFEORE_NAME : `${pageTitle} | ${CAFEORE_NAME}`;
const ogType = isHome ? "website" : "article";

// 検索結果に出さないページに構造化データを置く意味はないので noIndex なら出さない
const site = Astro.site ?? new URL(Astro.url.origin);
const jsonLdText = noIndex
  ? null
  : serializeJsonLd([organizationNode(site), webSiteNode(site), ...jsonLd]);
---

<!doctype html>
<html lang="ja">
  <head prefix="og: http://ogp.me/ns#">
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:type" content={ogType} />
    <meta property="og:url" content={Astro.url.href} />
    {ogImageUrl && <meta property="og:image" content={ogImageUrl} />}
    {noIndex && <meta name="robots" content="noindex" />}
    <title>{fullTitle}</title>
    {
      jsonLdText && (
        <script type="application/ld+json" is:inline set:html={jsonLdText} />
      )
    }
  </head>
  <body>
    <slot />
  </body>
</html>
